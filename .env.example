# ===== 环境变量模板 =====
# 复制此文件为 .env 并填入实际密钥
# cp .env.example .env

# ---------- 模拟盘 API 密钥 ----------
OKX_DEMO_API_KEY=your_demo_api_key
OKX_DEMO_SECRET_KEY=your_demo_secret_key
OKX_DEMO_PASSWORD=your_demo_password

# ---------- 实盘 API 密钥 ----------
OKX_LIVE_API_KEY=your_live_api_key
OKX_LIVE_SECRET_KEY=your_live_secret_key
OKX_LIVE_PASSWORD=your_live_password

# ---------- 通用配置 ----------
# 本地代理（海外服务器部署时留空）
PROXY_URL=http://127.0.0.1:7897

# 下单数量（ETH）
AMOUNT_ETH=10
